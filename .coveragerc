[run]
source = src
omit = 
    src/data_assimilation/*
    src/inputs/*
    src/utils/debug_helpers.py
    */tests/*
    */test_*
    setup.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:

[html]
directory = htmlcov